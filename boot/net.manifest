# The network test (cargo xtask net-test).
#
# The virtio-net driver serves the nic interface to the network server,
# which serves net to the client. On QEMU's user-mode network the client
# pings the gateway and has the host echo UDP datagrams back, while the
# injector kills the network server and the driver at pseudo-random
# moments: every ping and datagram must come back, the client sending
# again when an answer is late and binding again when the server forgot
# its socket. Component numbers matter: the injector kills components 1
# and 2.

component pcibus
  image pcibus
  priority 12
  provides pci 0
  device pci-config 1
  device pci-mmio 2
  device msi 3
  device iommu 11
  untyped 18 12

component virtio-net
  image virtio-net
  priority 11
  uses pci 0
  provides nic 1
  notification 2
  untyped 16 3

component net
  image net
  priority 10
  uses nic 0
  provides net 1
  untyped 16 2

component client
  image testclient
  arg 13
  priority 8
  uses net 0
  control 1
  untyped 12 2

component injector
  image testclient
  arg 10
  priority 8
  control 0
  fault-injector
  notification 1
