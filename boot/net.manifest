# The network test (cargo xtask net-test).
#
# The virtio-net driver serves the nic interface to the network server,
# which serves net to the resolver and the client. On QEMU's user-mode
# network the client pings the gateway, has the host echo UDP datagrams
# back and resolves names through the resolver, while the injector kills
# the driver, the network server and the resolver at pseudo-random
# moments: every ping, datagram and name must come back right, the client
# sending again when an answer is late and binding again when the server
# forgot its socket. Component numbers matter: the injector kills
# components 1, 2 and 3.

component pcibus
  image pcibus
  priority 12
  provides pci 0
  device pci-config 1
  device pci-mmio 2
  device msi 3
  device iommu 11
  untyped 18 12

component virtio-net
  image virtio-net
  priority 11
  uses pci 0
  provides nic 1
  notification 2
  untyped 16 3

component net
  image net
  # Renew the DHCP lease every 2 s (QEMU's lasts a day), so the test
  # sees renewals; the lease is kept in the state page across restarts.
  arg 200
  priority 10
  uses nic 0
  provides net 1
  # 256 KiB: a page for each socket's queue entries, besides the rest.
  untyped 18 2
  state 17

# Names: asks the gateway's port 47053, where xtask answers DNS on the
# host (QEMU's own DNS server would ask the real internet).
component dns
  image dns
  arg 47053
  priority 9
  uses net 0
  provides dns 1
  untyped 12 2

component client
  image testclient
  arg 13
  priority 8
  uses net 0
  uses dns 5
  control 1
  untyped 12 2

component injector
  image testclient
  arg 16
  priority 8
  control 0
  fault-injector
  notification 1
