# The filesystem test, first boot (cargo xtask fs-test).
#
# A client appends records to a file while the injector kills the
# filesystem server and the disk driver at pseudo-random moments; every
# acknowledged record must read back. The client then appends one more and
# shuts the machine down at once. boot/fs-verify.manifest boots the same
# disk again. Component numbers matter: the client is component 3 in both,
# so it gets the same container; the injector kills components 1 and 2.
# Three load clients append to files of their own meanwhile, so calls
# from several clients wait at once and share a commit.

component pcibus
  image pcibus
  priority 12
  # 2^7 slots: an ECAM page for each of 32 functions, BAR pages, domains.
  cspace 7
  provides pci 0
  device pci-config 1
  device pci-mmio 2
  # Ports for I/O BARs.
  device pci-io 84
  device msi 3
  device iommu 11
  untyped 18 12

component virtio-blk
  image virtio-blk
  priority 11
  uses pci 0
  provides block 1
  notification 2
  # 128 KiB: enough for any disk driver (cargo xtask nvme-test and
  # ahci-test boot this manifest with nvme or ahci in its place; NVMe
  # makes a thread, stack and queue pair per I/O queue, AHCI a thread
  # and stack per command slot and command pages per port).
  untyped 17 3

component fs
  image fs
  priority 10
  uses block 0
  provides fs 1
  untyped 19 2
  cspace 8

component client
  image testclient
  arg 7
  priority 8
  uses fs 0
  control 1
  untyped 12 2
  shared 16 16

component injector
  image testclient
  arg 10
  priority 8
  control 0
  fault-injector
  notification 1

component load1
  image testclient
  arg 21
  priority 8
  uses fs 0
  untyped 12 1

component load2
  image testclient
  arg 21
  priority 8
  uses fs 0
  untyped 12 1

component load3
  image testclient
  arg 21
  priority 8
  uses fs 0
  untyped 12 1
