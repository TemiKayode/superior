# The Component Manager's boot test (cargo xtask cm-test).
#
# The probe starts first, at a higher priority, so its fault is handled
# before the client finishes. echo and spare are lazy: echo starts on the
# client's first call; nothing ever calls spare, so it never starts. The
# spinner competes with the client for the CPU, both with the direction
# flag set, so a kernel entry that leaves the flag set shows up. echo
# runs in a two-level CSpace (64 CNodes of 16 slots under a root) and
# serves through slot 1000, index 8 of the CNode in root slot 62.

component probe
  image testclient
  arg 1
  priority 11
  restart never
  control 1

component spinner
  image testclient
  arg 15
  restart never

component client
  image testclient
  arg 0
  uses echo 0
  control 1

component echo
  image echo
  start lazy
  cspace 10 4
  arg 1000
  provides echo 1000

component spare
  image echo
  start lazy
  provides spare 0
