# The input test (cargo xtask input-test).
#
# The desktop of the desktop test with input: the HID driver serves a USB
# keyboard, a USB mouse and a USB tablet on QEMU's xHCI controller to the
# compositor, which draws the pointer, gives the window under it pointer
# and wheel events, gives the keyboard focus to the window clicked and its
# keys to the window with the focus. The host moves the mouse and the
# tablet, clicks, turns the wheel and types through QEMU's monitor and
# checks screenshots; the second client checks what its window
# got and kills the compositor and then the HID driver. Component numbers
# matter: the second client kills components 2 and 4.

component pcibus
  image pcibus
  priority 12
  cspace 7
  provides pci 0
  device pci-config 1
  device pci-mmio 2
  device pci-io 88
  device msi 3
  device iommu 11
  untyped 18 12
  device intx 80

component xhci
  image xhci
  priority 11
  uses pci 0
  provides usb 1
  notification 2
  untyped 17 3

component hid
  image hid
  priority 11
  uses usb 0
  provides input 1
  untyped 14 2

component lde-bochs
  image lde-bochs
  priority 11
  cspace 11
  vspace 18
  uses pci 0
  provides display 1
  notification 2
  memory 22
  untyped 20 3

component compositor
  image compositor
  priority 10
  # Its slots: the screen (up to 1024 pages) and 8 windows of up to 384
  # pages each.
  cspace 13
  # Page tables for the screen and the windows.
  vspace 17
  uses display 0
  provides window 1
  notification 2
  # 2 MiB for the screen (800x600 at 32 bits is 469 pages).
  memory 22
  untyped 21 3
  uses input 6

component first
  image testclient
  arg 27
  priority 8
  uses window 0
  cspace 8
  # Its window: 300x200 at 32 bits is 59 pages.
  memory 21
  untyped 19 2

component second
  image testclient
  arg 28
  priority 8
  uses window 0
  control 1
  fault-injector
  cspace 8
  # Its window: 320x240 at 32 bits is 75 pages.
  memory 21
  untyped 19 2
