# The suspend test (cargo xtask suspend-test).
#
# The client asks the Component Manager to suspend the machine (it is
# `power-control`). The manager tells the virtio-blk driver (a `power`
# component) to quiesce, and it resets its disk, then the PCI bus server
# (also `power`) to keep every function's configuration. On x86-64 the
# kernel suspends the machine to RAM (ACPI S3) until the RTC alarm, the
# second time until a key is pressed; on AArch64 it stops every CPU's tick
# and halts them all until a one-shot alarm. Then the bus server puts the
# configuration back, the driver brings the disk up again and the client
# reads it.

component pcibus
  image pcibus
  priority 12
  # 2^7 slots: an ECAM page for each of 32 functions, BAR pages, domains.
  cspace 7
  provides pci 0
  device pci-config 1
  device pci-mmio 2
  # Ports for I/O BARs.
  device pci-io 88
  # MSI vectors: slots 3 to 10.
  device msi 3
  device iommu 11
  # Memory for the IOMMU domains: 64 KiB each, four at once.
  untyped 18 12
  # Keeps every function's configuration across a suspend to RAM, which
  # resets the devices; suspended last and resumed first.
  power

component virtio-blk
  image virtio-blk
  priority 11
  uses pci 0
  provides block 1
  notification 2
  untyped 17 3
  power

component client
  image testclient
  arg 31
  uses block 0
  untyped 15 2
  control 3
  power-control
