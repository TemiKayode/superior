# The driver framework test (cargo xtask drivers-test).
#
# The PCI bus server owns configuration space, the BAR window, the MSI
# vectors and the IOMMU, and gives each driver's device its own IOMMU
# domain. The virtio-blk driver opens its one device through it and
# serves the block interface; the client reads the test disk through it,
# checks the bus server will not give it the driver's device, has the
# driver make its device raise an MSI vector routed to no device (which
# must not arrive) and point it at memory outside its domain (which must
# stay untouched), crashes the driver and reads again once the manager has
# restarted it.

component pcibus
  image pcibus
  priority 12
  # 2^7 slots: an ECAM page for each of 32 functions, BAR pages, domains.
  cspace 7
  provides pci 0
  device pci-config 1
  device pci-mmio 2
  # Ports for I/O BARs.
  device pci-io 88
  # MSI vectors: slots 3 to 10.
  device msi 3
  device iommu 11
  # Memory for the IOMMU domains: 64 KiB each, four at once.
  untyped 18 12

component virtio-blk
  image virtio-blk
  # Fault injection on, for the test.
  arg 1
  priority 11
  uses pci 0
  provides block 1
  notification 2
  # 128 KiB: enough for any disk driver (cargo xtask nvme-test and
  # ahci-test boot this manifest with nvme or ahci in its place; NVMe
  # makes a thread, stack and queue pair per I/O queue, AHCI a thread
  # and stack per command slot and command pages per port).
  untyped 17 3

component client
  image testclient
  arg 4
  uses block 0
  uses pci 1
  # 32 KiB: a buffer, and a second thread with its stack and buffer.
  untyped 15 2
  control 3
