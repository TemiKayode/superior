# The package test (cargo xtask packages-test).
#
# `packages block` keeps a store of signed app packages on the disk; the
# Component Manager installs each at boot, and the installer (it has
# `install-control`) writes packages into the store and asks the manager
# to install them. Apps may use only the services named by `app-service`:
# here the installer's `report`, which the test's app calls.

packages block
app-service report

component pcibus
  image pcibus
  priority 12
  # 2^7 slots: an ECAM page for each of 32 functions, BAR pages, domains.
  cspace 7
  provides pci 0
  device pci-config 1
  device pci-mmio 2
  # Ports for I/O BARs.
  device pci-io 84
  # MSI vectors: slots 3 to 10.
  device msi 3
  device iommu 11
  # Memory for the IOMMU domains: 64 KiB each, four at once.
  untyped 18 12

component virtio-blk
  image virtio-blk
  priority 11
  uses pci 0
  provides block 1
  notification 2
  untyped 17 3

component installer
  image testclient
  arg 35
  uses block 0
  untyped 15 2
  control 3
  provides report 5
  install-control
