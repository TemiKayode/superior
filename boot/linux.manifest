# The Linux personality test (cargo xtask linux-test).
#
# The personality runs Alpine Linux's BusyBox, unmodified: a dynamically
# linked, position-independent executable, with musl's dynamic linker
# (also its C library) as its interpreter. Both come from the bundle as
# files, copied into the personality's own memory, with pigz and the zlib
# it links to (a threaded program, and a library musl loads), and three
# Linux programs of our own: fptest (its floating-point registers kept
# across a signal handler, user/linux-fptest), smptest (two of its
# threads running at once, user/linux-smptest) and mmaptest (memory it
# unmaps used again, user/linux-mmaptest). From Debian, glibc's dynamic
# linker and C library and GNU hello, linked against them. A toolchain:
# tcc (compiler, assembler and linker) and make, with musl's headers and
# start files (tools, an archive unpacked into the tree), and GNU
# binutils' as and ld, with their libraries and zstd's, and gcc (its
# driver, cc1, collect2, runtime library, and GMP, MPFR, MPC and isl).
# Shell
# scripts run with processes (fork, execve, wait4), pipes and an
# in-memory file tree. Each process is an address space and its threads,
# made from one of seven blocks cut from the untyped memory in slot 0, and
# revoked when it exits or execs; the eighth block holds the
# personality's state and the files' pages. A process that outgrows its
# block is lent one of four more, cut from the rest of RAM (untyped spare).
# The root (with /home) is the filesystem server's, on a disk the test
# makes empty; what the runs leave there, boot/linux-verify.manifest reads
# back. Sockets are the network server's: the runs fetch a page over HTTP
# from the host, have TCP and UDP echoed, and serve a connection from it.

# The disk under the root: PCI, its driver and the filesystem server, as
# boot/fs.manifest has them. The personality is component 5 here and in
# boot/linux-verify.manifest, so both boots see the same container.

component pcibus
  image pcibus
  priority 12
  # 2^7 slots: an ECAM page for each of 32 functions, BAR pages, domains.
  cspace 7
  provides pci 0
  device pci-config 1
  device pci-mmio 2
  # Ports for I/O BARs.
  device pci-io 88
  device msi 3
  device iommu 11
  untyped 18 12

component virtio-blk
  image virtio-blk
  priority 11
  uses pci 0
  provides block 1
  notification 2
  untyped 17 3

component fs
  image fs
  priority 10
  uses block 0
  provides fs 1
  untyped 19 2
  cspace 8

# The network under the personality's sockets, as boot/net.manifest has
# it. Before the personality: its 16 MiB block is aligned to its size, and
# after it there would be no room left in the manager's memory.

component virtio-net
  image virtio-net
  priority 11
  uses pci 0
  provides nic 1
  notification 2
  untyped 16 3

component net
  image net
  priority 10
  uses nic 0
  provides net 1
  memory 22
  untyped 21 2
  state 17
  shared 13 18
  cspace 9

component linux
  image linux
  priority 10
  # Its CNode (2^16 slots: the state's and files' pages, the files,
  # glibc's from 8192, the toolchain's from 8832, the buffer at 9216,
  # binutils' from 9472, gcc's from 11072, and a 6144-slot span per
  # process from 22528), address space, image, stack, the thirty files
  # (copied into its memory, 64 MiB for them) and the 8 MiB block.
  memory 26
  cspace 16
  vspace 20
  # The files before the blocks, smallest first: memory is handed out in
  # order, and each block is aligned to its size.
  file ld-musl 16
  file mmaptest 177
  file pigz 180
  file smptest 213
  file libz 216
  file fptest 250
  file hello 8256
  file ld-glibc 8192
  file busybox 252
  file libc 8320
  file tcc 8832
  file make 8864
  file libtcc 8960
  file tools 9088
  file as 9472
  file ld 9664
  file libbfd 10112
  file libctf 10432
  file libsframe 10496
  file libzstd 10528
  file libopcodes 10752
  file cc1 11072
  file gcc 19328
  file collect2 19664
  file libgcc-a 19840
  file libgmp 20608
  file libmpfr 20736
  file libmpc 20912
  file libisl 20960
  file libgcc-s 21504
  untyped 23 0
  # The rest of RAM, for the spare blocks (slots 920 on).
  untyped spare 920
  control 1
  # Its files on the disk (the root, but for /bin, /usr, /lib, /dev, /tmp).
  uses fs 6
  # Sockets: the network server's.
  uses net 7
  # The terminal: the serial console's UART and its interrupt.
  device uart 3
  device uart-irq 4
