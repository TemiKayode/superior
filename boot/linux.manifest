# The Linux personality test (cargo xtask linux-test).
#
# The personality runs Alpine Linux's BusyBox, unmodified: a dynamically
# linked, position-independent executable, with musl's dynamic linker
# (also its C library) as its interpreter. Both come from the bundle as
# files, copied into the personality's own memory, with pigz and the zlib
# it links to (a threaded program, and a library musl loads). Shell
# scripts run with processes (fork, execve, wait4), pipes and an
# in-memory file tree. Each process is an address space and its threads,
# made from one of seven blocks cut from the untyped memory in slot 0, and
# revoked when it exits or execs; the eighth block holds the
# personality's state and the files' pages. A process that outgrows its
# block is lent one of four more, cut from the untyped memory in slot 5.
# /home is the filesystem server's, on a disk the test makes empty; what
# the runs leave there, boot/linux-verify.manifest reads back.

# The disk under /home: PCI, its driver and the filesystem server, as
# boot/fs.manifest has them. The personality is component 3 here and in
# boot/linux-verify.manifest, so both boots see the same container.

component pcibus
  image pcibus
  priority 12
  # 2^7 slots: an ECAM page for each of 32 functions, BAR pages, domains.
  cspace 7
  provides pci 0
  device pci-config 1
  device pci-mmio 2
  # Ports for I/O BARs.
  device pci-io 88
  device msi 3
  device iommu 11
  untyped 18 12

component virtio-blk
  image virtio-blk
  priority 11
  uses pci 0
  provides block 1
  notification 2
  untyped 17 3

component fs
  image fs
  priority 10
  uses block 0
  provides fs 1
  untyped 19 2
  cspace 8

component linux
  image linux
  priority 10
  # Its CNode (2^13 slots: a 1024-slot span per process, the state's and
  # files' pages, the files), address space, image, stack, the four files,
  # the 8 MiB block and the 4 MiB one.
  memory 24
  cspace 13
  vspace 20
  # The files before the blocks, smallest first: memory is handed out in
  # order, and each block is aligned to its size.
  file ld-musl 16
  file pigz 180
  file libz 216
  file busybox 250
  untyped 22 5
  untyped 23 0
  control 1
  # Its files under /home.
  uses fs 6
  # The terminal: the serial console's UART and its interrupt.
  device uart 3
  device uart-irq 4
