# The Linux personality test, second boot (cargo xtask linux-test).
#
# boot/linux.manifest with the personality's arg 1: on the same disk, it
# runs only what reads back the files the first boot left on the disk,
# then stops.


# The disk under the root: PCI, its driver and the filesystem server, as
# boot/fs.manifest has them. The personality is component 5 here and in
# boot/linux-verify.manifest, so both boots see the same container.

component pcibus
  image pcibus
  priority 12
  # 2^7 slots: an ECAM page for each of 32 functions, BAR pages, domains.
  cspace 7
  provides pci 0
  device pci-config 1
  device pci-mmio 2
  # Ports for I/O BARs.
  device pci-io 88
  device msi 3
  device iommu 11
  untyped 18 12

component virtio-blk
  image virtio-blk
  priority 11
  uses pci 0
  provides block 1
  notification 2
  untyped 17 3

component fs
  image fs
  priority 10
  uses block 0
  provides fs 1
  untyped 19 2
  cspace 8

# The network under the personality's sockets, as boot/net.manifest has
# it. Before the personality: its 16 MiB block is aligned to its size, and
# after it there would be no room left in the manager's memory.

component virtio-net
  image virtio-net
  priority 11
  uses pci 0
  provides nic 1
  notification 2
  untyped 16 3

component net
  image net
  priority 10
  uses nic 0
  provides net 1
  memory 22
  untyped 21 2
  state 17
  shared 13 18
  cspace 9

component linux
  image linux
  arg 1
  priority 10
  # Its CSpace (2^20 slots in two levels: the files, the state's and
  # files' pages from 23552, then the shared pages, the exec buffer and
  # the framebuffer's, and past them its processes' slots from 65536, in
  # leaves it makes from their memory: `cnode`, its root), address space,
  # image, stack, the four files (its processes' memory is cut from the
  # rest of RAM).
  memory 24
  cspace 20 10 16
  cnode 65534
  vspace 20
  # The files, smallest first: memory is handed out in order, and each
  # block is aligned to its size.
  file ld-musl 16
  file pigz 180
  file libz 216
  file busybox 252
  # The rest of RAM, for the spare blocks (slots 920 on).
  untyped spare 920
  control 1
  # Its files on the disk (the root, but for /bin, /usr, /lib, /dev, /tmp).
  uses fs 6
  # The terminal: the serial console's UART and its interrupt.
  device uart 3
  device uart-irq 4
